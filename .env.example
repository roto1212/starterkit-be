# 이 파일은 placeholder만 담는다. 실제 값은 .env 에 채우고 .env 는 절대 커밋하지 않는다.
# 시작 절차는 docs/BOOTSTRAP.md 참조.

ENV=dev

# ── DB (부품만 넘긴다 — URL은 app/config.py 가 조립한다) ──
DB_HOST=localhost
DB_PORT=1433
DB_NAME=starterkit_be
DB_USER=
DB_PASSWORD=
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# 공유 MSSQL 인스턴스에 여러 프로젝트가 붙는 현실 때문에 프로젝트마다 반드시
# 바꿔야 한다. scripts/rename_project.py 가 자동으로 갱신한다.
ALEMBIC_VERSION_TABLE=alembic_version_starterkit_be

# ── 인증 (신원 저장소 슬라이스를 삭제했다면 이 블록도 함께 제거) ──
# 아래 값 그대로 두면 fail-fast 로 부팅이 거부된다.
# 생성: uv run python scripts/generate_secret.py
JWT_SECRET_KEY=CHANGE_ME_run_scripts_generate_secret_to_create_a_real_key
JWT_ISSUER=starterkit-be
JWT_AUDIENCE=starterkit-be-clients
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

LOGIN_FAIL_WINDOW_SEC=600
LOGIN_FAIL_MAX=10
LOGIN_LOCK_SEC=300

# ── 로깅 ──
LOG_LEVEL=DEBUG
LOG_FORMAT=rich

# ── CORS / 쿠키 ──
# 로컬 개발에서 FE(Vite dev server 등)가 다른 포트/오리진이면 여기에 콤마로 나열
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
